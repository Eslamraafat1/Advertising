# Public site URL used for canonical links, sitemap.xml and robots.txt.
# Optional on Vercel (falls back to the production domain); never localhost.
NEXT_PUBLIC_SITE_URL=

# Admin token for the demo /dashboard and POST /api/ads in production.
# Leave empty to keep editing disabled. Send it as the x-admin-token header
# (the dashboard asks for it) or an admin_token cookie.
ADMIN_TOKEN=
